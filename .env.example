# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are baked into the client bundle at build time.

# Lapel API base for the "SharedDrive for Business" pages (/business/*), including the device segment.
# Default when unset: https://api.sharedrive.ng/lapel/api/v1/web
NEXT_PUBLIC_LAPEL_API_URL=https://api.sharedrive.ng/lapel/api/v1/web

# maol_service base URL and API key used by the contact/support/account-deletion forms (lib/publicMail.ts).
NEXT_PUBLIC_MAIL_SERVICE_URL=
NEXT_PUBLIC_MAIL_API_KEY=

# Google Search Console HTML-tag verification token (the content="..." value only). Rendered as
# <meta name="google-site-verification"> on every page; omitted when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
